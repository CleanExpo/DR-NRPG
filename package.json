{
  "name": "nrpg",
  "version": "1.0.0",
  "description": "Disaster Recovery NRPG Platform - Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check:au-english": "node scripts/check-au-english.mjs",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:web": "turbo run dev --filter=nrpg-web",
    "dev:backend": "turbo run dev --filter=backend",
    "build:web": "turbo run build --filter=nrpg-web",
    "build:backend": "turbo run build --filter=backend",
    "test:web": "turbo run test --filter=nrpg-web",
    "test:backend": "turbo run test --filter=backend",
    "db:generate": "turbo run db:generate --filter=nrpg-web",
    "db:push": "turbo run db:push --filter=nrpg-web",
    "db:migrate": "turbo run db:migrate --filter=nrpg-web",
    "db:studio": "turbo run db:studio --filter=nrpg-web",
    "seed:demo-admin": "tsx scripts/seed-demo-admin.ts",
    "seed:demo-admin-full": "tsx scripts/seed-demo-admin-with-tenant.ts",
    "storybook": "turbo run storybook --filter=nrpg-web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "test:smoke": "pnpm --filter nrpg-web exec jest --config ../../jest.smoke.config.js --verbose --forceExit",
    "training:generate-images": "tsx scripts/generate-training-images.ts",
    "training:integrate-images": "tsx scripts/integrate-training-images.ts"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^20.19.41",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.4",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.6",
      "basic-ftp": "^6.2.1",
      "handlebars": "^4.7.10",
      "undici": "^8.10.2",
      "rollup": ">=4.59.0",
      "path-to-regexp": ">=0.1.13",
      "minimatch": ">=9.0.7",
      "serialize-javascript": ">=7.0.3",
      "tar": "^7.5.21",
      "tar-fs": ">=3.1.1",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.1",
      "socket.io-parser": "^4.2.7",
      "ws": "^8.21.0",
      "vite": "^8.0.16",
      "storybook": ">=10.2.10",
      "@tootallnate/once": ">=3.0.1",
      "ajv": "^6.12.6",
      "bn.js": ">=5.2.3",
      "brace-expansion": "^5.0.11",
      "diff": ">=7.0.0",
      "dompurify": "^3.4.13",
      "file-type": ">=21.3.1",
      "follow-redirects": ">=1.16.0",
      "langsmith": ">=0.5.19",
      "nodemailer": ">=8.0.5",
      "protobufjs": "^8.4.1",
      "qs": "^6.16.0",
      "tmp": "^0.2.6",
      "uuid@>=13.0.0 <13.0.1": ">=13.0.1",
      "uuid@>=11.0.0 <11.1.1": ">=11.1.1",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4",
      "basic-ftp@<=5.3.0": "^6.2.1",
      "fast-xml-parser@<5.7.0": ">=5.7.0",
      "proxy-addr": "^2.0.8",
      "postcss@<8.5.18": "^8.5.18",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "ip-address@<10.3.1": "^10.3.1",
      "js-yaml@>=3 <3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "nanoid@>=5 <5.1.16": "^5.1.16",
      "engine.io@>=6 <6.6.10": "^6.6.10",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "compression@<1.8.2": "^1.8.2",
      "image-size@>=2 <2.0.3": "^2.0.3",
      "smol-toml@<1.7.1": "^1.7.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "webpack-dev-middleware@>=7 <7.4.6": "^7.4.6",
      "linkify-it@>=5 <5.0.2": "^5.0.2",
      "browserslist@<4.28.7": "^4.28.7",
      "markdown-it@>=14 <14.3.1": "^14.3.1",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "fflate@>=0.6.0 <0.6.11": "^0.6.11",
      "pbkdf2@<3.1.7": "^3.1.7"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "overrides": {
    "axios": ">=1.15.2",
    "handlebars": ">=4.7.9",
    "serialize-javascript": ">=7.0.3",
    "basic-ftp": ">=5.3.0",
    "lodash": ">=4.18.1",
    "lodash-es": ">=4.18.1"
  }
}
