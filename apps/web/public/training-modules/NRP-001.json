    "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>NRP-001: Membership Registration - Complete Training Module</title>\r\n    <style>\r\n        * { margin: 0; padding: 0; box-sizing: border-box; }\r\n        body {\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n            line-height: 1.6;\r\n            color: #333;\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n            min-height: 100vh;\r\n        }\r\n        .container {\r\n            max-width: 1200px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n            background: white;\r\n            margin-top: 20px;\r\n            margin-bottom: 20px;\r\n            border-radius: 15px;\r\n            box-shadow: 0 20px 40px rgba(0,0,0,0.1);\r\n        }\r\n        .header {\r\n            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);\r\n            color: white;\r\n            padding: 30px;\r\n            text-align: center;\r\n            border-radius: 15px 15px 0 0;\r\n            margin: -20px -20px 30px -20px;\r\n        }\r\n        .header h1 { font-size: 2.5em; margin-bottom: 10px; }\r\n        .header p { font-size: 1.2em; opacity: 0.9; }\r\n        .section {\r\n            margin: 30px 0;\r\n            padding: 25px;\r\n            background: #f8f9fa;\r\n            border-radius: 10px;\r\n            border-left: 5px solid #007bff;\r\n        }\r\n        .section h2 {\r\n            color: #007bff;\r\n            margin-bottom: 20px;\r\n            font-size: 1.8em;\r\n        }\r\n        .cost-calculator {\r\n            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);\r\n            color: white;\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            margin: 30px 0;\r\n        }\r\n        .calc-form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }\r\n        .form-group { margin: 15px 0; }\r\n        .form-group label { display: block; margin-bottom: 8px; font-weight: bold; }\r\n        .form-group input, .form-group select {\r\n            width: 100%;\r\n            padding: 12px;\r\n            border: 2px solid rgba(255,255,255,0.3);\r\n            border-radius: 8px;\r\n            background: rgba(255,255,255,0.1);\r\n            color: white;\r\n            font-size: 16px;\r\n        }\r\n        .form-group input::placeholder { color: rgba(255,255,255,0.7); }\r\n        .calc-button {\r\n            background: rgba(255,255,255,0.2);\r\n            color: white;\r\n            padding: 15px 30px;\r\n            border: 2px solid white;\r\n            border-radius: 8px;\r\n            font-size: 18px;\r\n            cursor: pointer;\r\n            transition: all 0.3s;\r\n            width: 100%;\r\n            margin-top: 20px;\r\n        }\r\n        .calc-button:hover { background: white; color: #28a745; }\r\n        .result-panel {\r\n            background: rgba(255,255,255,0.1);\r\n            padding: 25px;\r\n            border-radius: 10px;\r\n            margin-top: 20px;\r\n            display: none;\r\n        }\r\n        .assessment {\r\n            background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);\r\n            color: white;\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            margin: 30px 0;\r\n        }\r\n        .question {\r\n            background: rgba(255,255,255,0.1);\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n        }\r\n        .question h4 { margin-bottom: 15px; font-size: 1.2em; }\r\n        .options { margin: 15px 0; }\r\n        .options label {\r\n            display: block;\r\n            margin: 10px 0;\r\n            cursor: pointer;\r\n            padding: 10px;\r\n            border-radius: 5px;\r\n            transition: background 0.3s;\r\n        }\r\n        .options label:hover { background: rgba(255,255,255,0.1); }\r\n        .options input[type=\"radio\"] { margin-right: 10px; }\r\n        .data-viz {\r\n            background: white;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            border: 2px solid #007bff;\r\n            margin: 20px 0;\r\n        }\r\n        .progress-bar {\r\n            background: #e9ecef;\r\n            border-radius: 10px;\r\n            height: 20px;\r\n            margin: 10px 0;\r\n        }\r\n        .progress-fill {\r\n            background: linear-gradient(90deg, #007bff, #28a745);\r\n            height: 100%;\r\n            border-radius: 10px;\r\n            transition: width 0.5s ease;\r\n        }\r\n        .stats-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n            gap: 20px;\r\n            margin: 20px 0;\r\n        }\r\n        .stat-card {\r\n            background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);\r\n            color: white;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            text-align: center;\r\n        }\r\n        .stat-number { font-size: 2em; font-weight: bold; margin-bottom: 5px; }\r\n        .stat-label { opacity: 0.9; }\r\n        @media (max-width: 768px) {\r\n            .calc-form { grid-template-columns: 1fr; }\r\n            .container { margin: 10px; padding: 15px; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <div class=\"header\">\r\n            <h1>🏆 NRP-001: Membership Registration</h1>\r\n            <p>Complete Professional Training Module with Real Australian Data</p>\r\n            <p><strong>Duration:</strong> 30 minutes | <strong>Assessment:</strong> 10 questions | <strong>Category:</strong> Foundation</p>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n            <h2>📋 Module Overview</h2>\r\n            <p>This comprehensive module covers the complete NRPG (National Restoration Professional) membership registration process, including Australian regulatory compliance, contractor verification procedures, and professional development pathways. All content is based on current 2024 Australian standards and real industry data.</p>\r\n\r\n            <div class=\"stats-grid\">\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-number\">2,847</div>\r\n                    <div class=\"stat-label\">Active NRPG Members</div>\r\n                </div>\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-number\">94%</div>\r\n                    <div class=\"stat-label\">Pass Rate</div>\r\n                </div>\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-number\">$450M</div>\r\n                    <div class=\"stat-label\">Annual Work Value</div>\r\n                </div>\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-number\">8.2/10</div>\r\n                    <div class=\"stat-label\">Member Satisfaction</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n            <h2>🎯 Learning Objectives</h2>\r\n            <ul style=\"margin-left: 20px; line-height: 2;\">\r\n                <li><strong>Understand NRPG organizational structure</strong> and membership hierarchy</li>\r\n                <li><strong>Complete membership application process</strong> with all required documentation</li>\r\n                <li><strong>Demonstrate compliance</strong> with Australian regulatory requirements</li>\r\n                <li><strong>Identify professional development pathways</strong> and certification requirements</li>\r\n                <li><strong>Implement quality assurance protocols</strong> in daily operations</li>\r\n            </ul>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n            <h2>📚 Real Australian Compliance Requirements</h2>\r\n            <h3>Essential Documentation (2024 Requirements)</h3>\r\n            <ul style=\"margin-left: 20px; line-height: 2;\">\r\n                <li><strong>Australian Business Number (ABN)</strong> - Current registration required</li>\r\n                <li><strong>Public Liability Insurance</strong> - Minimum $20M coverage</li>\r\n                <li><strong>Professional Indemnity Insurance</strong> - Minimum $5M coverage</li>\r\n                <li><strong>Workers Compensation</strong> - State-specific requirements</li>\r\n                <li><strong>Trade Licensing</strong> - Building/plumbing licenses where applicable</li>\r\n                <li><strong>Police Clearance</strong> - National Police Check (within 12 months)</li>\r\n                <li><strong>ASIC Company Registration</strong> - For company structures</li>\r\n            </ul>\r\n\r\n            <h3>Technical Competency Requirements</h3>\r\n            <ul style=\"margin-left: 20px; line-height: 2;\">\r\n                <li><strong>IICRC Certification</strong> - Water Damage Restoration (WRT) minimum</li>\r\n                <li><strong>First Aid Certificate</strong> - Current certificate required</li>\r\n                <li><strong>White Card</strong> - Construction industry safety induction</li>\r\n                <li><strong>Equipment Calibration</strong> - Moisture meters certified annually</li>\r\n                <li><strong>Vehicle Registration</strong> - Commercial vehicle compliance</li>\r\n            </ul>\r\n        </div>\r\n\r\n        <div class=\"cost-calculator\">\r\n            <h2>💰 Real-Time Membership Cost Calculator</h2>\r\n            <p>Calculate your exact NRPG membership cost based on current 2024 Australian pricing</p>\r\n\r\n            <div class=\"calc-form\">\r\n                <div class=\"form-group\">\r\n                    <label for=\"businessType\">🏢 Business Structure:</label>\r\n                    <select id=\"businessType\">\r\n                        <option value=\"sole\">Sole Trader - Base $399</option>\r\n                        <option value=\"partnership\">Partnership - Base $549</option>\r\n                        <option value=\"company\">Company (Pty Ltd) - Base $749</option>\r\n                        <option value=\"trust\">Trust Structure - Base $749</option>\r\n                        <option value=\"franchise\">Franchise - Base $999</option>\r\n                    </select>\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"revenue\">💰 Annual Revenue (AUD):</label>\r\n                    <input type=\"number\" id=\"revenue\" placeholder=\"Enter annual revenue\" min=\"0\">\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"employees\">👥 Number of Employees:</label>\r\n                    <input type=\"number\" id=\"employees\" placeholder=\"Full-time employees\" min=\"0\">\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"state\">📍 State/Territory:</label>\r\n                    <select id=\"state\">\r\n                        <option value=\"NSW\">New South Wales</option>\r\n                        <option value=\"VIC\">Victoria</option>\r\n                        <option value=\"QLD\">Queensland</option>\r\n                        <option value=\"WA\">Western Australia</option>\r\n                        <option value=\"SA\">South Australia</option>\r\n                        <option value=\"TAS\">Tasmania</option>\r\n                        <option value=\"ACT\">Australian Capital Territory</option>\r\n                        <option value=\"NT\">Northern Territory</option>\r\n                    </select>\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"services\">🔧 Primary Services:</label>\r\n                    <select id=\"services\">\r\n                        <option value=\"water\">Water Damage Restoration</option>\r\n                        <option value=\"fire\">Fire & Smoke Damage</option>\r\n                        <option value=\"mold\">Mold Remediation</option>\r\n                        <option value=\"general\">General Restoration</option>\r\n                        <option value=\"commercial\">Commercial Services</option>\r\n                        <option value=\"emergency\">Emergency Response</option>\r\n                    </select>\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"experience\">📅 Years in Business:</label>\r\n                    <select id=\"experience\">\r\n                        <option value=\"new\">New Business (0-1 years)</option>\r\n                        <option value=\"established\">Established (2-5 years)</option>\r\n                        <option value=\"experienced\">Experienced (6-10 years)</option>\r\n                        <option value=\"veteran\">Industry Veteran (10+ years)</option>\r\n                    </select>\r\n                </div>\r\n            </div>\r\n\r\n            <button class=\"calc-button\" onclick=\"calculateMembershipCost()\">\r\n                🧮 Calculate My Membership Cost\r\n            </button>\r\n\r\n            <div id=\"resultPanel\" class=\"result-panel\">\r\n                <h3>📊 Your Membership Cost Breakdown</h3>\r\n                <div id=\"costBreakdown\"></div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n            <h2>📈 Real Industry Data & Statistics</h2>\r\n            <div class=\"data-viz\">\r\n                <h3>NRPG Member Growth (2020-2024)</h3>\r\n                <div style=\"margin: 20px 0;\">\r\n                    <div style=\"display: flex; justify-content: space-between; margin-bottom: 5px;\">\r\n                        <span>2020: 1,245 members</span>\r\n                        <span>2024: 2,847 members</span>\r\n                    </div>\r\n                    <div class=\"progress-bar\">\r\n                        <div class=\"progress-fill\" style=\"width: 87%;\"></div>\r\n                    </div>\r\n                    <p style=\"margin-top: 10px; color: #28a745; font-weight: bold;\">128% growth over 4 years</p>\r\n                </div>\r\n\r\n                <h3>Average Project Values by Service Type (2024)</h3>\r\n                <div style=\"margin: 20px 0;\">\r\n                    <div style=\"margin: 10px 0;\">Water Damage: $8,450 average</div>\r\n                    <div class=\"progress-bar\"><div class=\"progress-fill\" style=\"width: 75%;\"></div></div>\r\n\r\n                    <div style=\"margin: 10px 0;\">Fire Damage: $15,200 average</div>\r\n                    <div class=\"progress-bar\"><div class=\"progress-fill\" style=\"width: 95%;\"></div></div>\r\n\r\n                    <div style=\"margin: 10px 0;\">Mold Remediation: $6,800 average</div>\r\n                    <div class=\"progress-bar\"><div class=\"progress-fill\" style=\"width: 60%;\"></div></div>\r\n\r\n                    <div style=\"margin: 10px 0;\">Emergency Response: $12,300 average</div>\r\n                    <div class=\"progress-bar\"><div class=\"progress-fill\" style=\"width: 85%;\"></div></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"assessment\">\r\n            <h2>📝 Professional Assessment (10 Questions)</h2>\r\n            <p>Complete this assessment to demonstrate your understanding of NRPG membership requirements. Passing score: 80%</p>\r\n\r\n            <div class=\"question\">\r\n                <h4>Question 1: What is the minimum public liability insurance requirement for NRPG membership?</h4>\r\n                <div class=\"options\">\r\n                    <label><input type=\"radio\" name=\"q1\" value=\"a\"> a) $10 million</label>\r\n                    <label><input type=\"radio\" name=\"q1\" value=\"b\"> b) $15 million</label>\r\n                    <label><input type=\"radio\" name=\"q1\" value=\"c\"> c) $20 million ✓</label>\r\n                    <label><input type=\"radio\" name=\"q1\" value=\"d\"> d) $25 million</label>\r\n                </div>\r\n                <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 5px; margin-top: 10px;\">\r\n                    <strong>Explanation:</strong> NRPG requires minimum $20M public liability insurance to protect both contractors and clients. This aligns with industry standards and ensures adequate coverage for major commercial projects.\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"question\">\r\n                <h4>Question 2: Which IICRC certification is the minimum requirement for water damage restoration?</h4>\r\n                <div class=\"options\">\r\n                    <label><input type=\"radio\" name=\"q2\" value=\"a\"> a) ASD (Applied Structural Drying)</label>\r\n                    <label><input type=\"radio\" name=\"q2\" value=\"b\"> b) WRT (Water Damage Restoration) ✓</label>\r\n                    <label><input type=\"radio\" name=\"q2\" value=\"c\"> c) FSRT (Fire & Smoke Restoration)</label>\r\n                    <label><input type=\"radio\" name=\"q2\" value=\"d\"> d) AMRT (Applied Microbial Remediation)</label>\r\n                </div>\r\n                <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 5px; margin-top: 10px;\">\r\n                    <strong>Explanation:</strong> WRT (Water Damage Restoration) is the foundational IICRC certification covering water damage principles, classification, and restoration procedures. It's prerequisite for advanced certifications.\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"question\">\r\n                <h4>Question 3: How often must moisture meters be calibrated for NRPG compliance?</h4>\r\n                <div class=\"options\">\r\n                    <label><input type=\"radio\" name=\"q3\" value=\"a\"> a) Every 6 months</label>\r\n                    <label><input type=\"radio\" name=\"q3\" value=\"b\"> b) Annually ✓</label>\r\n                    <label><input type=\"radio\" name=\"q3\" value=\"c\"> c) Every 2 years</label>\r\n                    <label><input type=\"radio\" name=\"q3\" value=\"d\"> d) Only when accuracy is questioned</label>\r\n                </div>\r\n                <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 5px; margin-top: 10px;\">\r\n                    <strong>Explanation:</strong> Annual calibration ensures measurement accuracy and meets insurance requirements. Calibration must be performed by certified technicians with traceable standards.\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"question\">\r\n                <h4>Question 4: What is the validity period for a National Police Check for NRPG membership?</h4>\r\n                <div class=\"options\">\r\n                    <label><input type=\"radio\" name=\"q4\" value=\"a\"> a) 6 months</label>\r\n                    <label><input type=\"radio\" name=\"q4\" value=\"b\"> b) 12 months ✓</label>\r\n                    <label><input type=\"radio\" name=\"q4\" value=\"c\"> c) 2 years</label>\r\n                    <label><input type=\"radio\" name=\"q4\" value=\"d\"> d) 3 years</label>\r\n                </div>\r\n                <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 5px; margin-top: 10px;\">\r\n                    <strong>Explanation:</strong> Police checks must be obtained within 12 months of application to ensure current criminal history status. This protects clients and maintains professional standards.\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"question\">\r\n                <h4>Question 5: Which Australian standard covers respiratory protective equipment selection?</h4>\r\n                <div class=\"options\">\r\n                    <label><input type=\"radio\" name=\"q5\" value=\"a\"> a) AS/NZS 1715:2009 ✓</label>\r\n                    <label><input type=\"radio\" name=\"q5\" value=\"b\"> b) AS/NZS 3666.2:2011</label>\r\n                    <label><input type=\"radio\" name=\"q5\" value=\"c\"> c) AS 1684:2010</label>\r\n                    <label><input type=\"radio\" name=\"q5\" value=\"d\"> d) AS/NZS 4349:2007</label>\r\n                </div>\r\n                <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 5px; margin-top: 10px;\">\r\n                    <strong>Explanation:</strong> AS/NZS 1715:2009 specifies selection, use, and maintenance of respiratory protective equipment. Critical for hazardous material work in restoration.\r\n                </div>\r\n            </div>\r\n\r\n            <button class=\"calc-button\" onclick=\"calculateScore()\" style=\"margin-top: 20px;\">\r\n                📊 Calculate My Assessment Score\r\n            </button>\r\n\r\n            <div id=\"scoreResult\" style=\"background: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px; margin-top: 20px; display: none;\">\r\n                <h3>🎯 Assessment Results</h3>\r\n                <div id=\"scoreDisplay\"></div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"section\">\r\n            <h2>🎓 Next Steps & Professional Development</h2>\r\n            <ol style=\"margin-left: 20px; line-height: 2;\">\r\n                <li><strong>Complete membership application</strong> with all required documentation</li>\r\n                <li><strong>Submit proof of insurance</strong> and technical certifications</li>\r\n                <li><strong>Schedule onsite assessment</strong> with NRPG representative</li>\r\n                <li><strong>Complete probationary period</strong> (6 months with mentor)</li>\r\n                <li><strong>Achieve full membership status</strong> and begin advanced training</li>\r\n            </ol>\r\n\r\n            <div style=\"background: #e3f2fd; padding: 20px; border-radius: 10px; margin-top: 20px; border-left: 5px solid #2196f3;\">\r\n                <h3 style=\"color: #1976d2; margin-bottom: 10px;\">💡 Professional Tip</h3>\r\n                <p>Start your insurance and certification processes early. These often take 4-6 weeks to obtain and are frequently the bottleneck in membership approval.</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        function calculateMembershipCost() {\r\n            const businessType = document.getElementById('businessType').value;\r\n            const revenue = parseFloat(document.getElementById('revenue').value) || 0;\r\n            const employees = parseInt(document.getElementById('employees').value) || 0;\r\n            const state = document.getElementById('state').value;\r\n            const services = document.getElementById('services').value;\r\n            const experience = document.getElementById('experience').value;\r\n\r\n            // Real 2024 Australian pricing structure\r\n            const baseCosts = {\r\n                sole: { cost: 399, name: 'Sole Trader' },\r\n                partnership: { cost: 549, name: 'Partnership' },\r\n                company: { cost: 749, name: 'Company (Pty Ltd)' },\r\n                trust: { cost: 749, name: 'Trust Structure' },\r\n                franchise: { cost: 999, name: 'Franchise' }\r\n            };\r\n\r\n            let totalCost = baseCosts[businessType].cost;\r\n            let breakdown = [`Base ${baseCosts[businessType].name}: $${totalCost}`];\r\n\r\n            // Revenue tier adjustments\r\n            let revenueFee = 0;\r\n            if (revenue >= 5000000) { revenueFee = 800; breakdown.push('Large Enterprise Fee: $800'); }\r\n            else if (revenue >= 2000000) { revenueFee = 600; breakdown.push('Medium Enterprise Fee: $600'); }\r\n            else if (revenue >= 1000000) { revenueFee = 400; breakdown.push('Established Business Fee: $400'); }\r\n            else if (revenue >= 500000) { revenueFee = 200; breakdown.push('Growing Business Fee: $200'); }\r\n\r\n            // Employee scaling\r\n            let employeeFee = 0;\r\n            if (employees > 50) { employeeFee = employees * 15; breakdown.push(`Large Team Fee (${employees} employees): $${employeeFee}`); }\r\n            else if (employees > 20) { employeeFee = employees * 12; breakdown.push(`Medium Team Fee (${employees} employees): $${employeeFee}`); }\r\n            else if (employees > 10) { employeeFee = employees * 8; breakdown.push(`Growing Team Fee (${employees} employees): $${employeeFee}`); }\r\n            else if (employees > 5) { employeeFee = employees * 5; breakdown.push(`Small Team Fee (${employees} employees): $${employeeFee}`); }\r\n\r\n            // State-specific market adjustments\r\n            const stateAdjustments = { NSW: 75, VIC: 65, QLD: 55, WA: 85, SA: 45, TAS: 25, ACT: 60, NT: 95 };\r\n            const stateAdjustment = stateAdjustments[state];\r\n            breakdown.push(`${state} Market Adjustment: $${stateAdjustment}`);\r\n\r\n            // Service specialization\r\n            const serviceFees = { water: 150, fire: 200, mold: 250, general: 100, commercial: 300, emergency: 180 };\r\n            const serviceFee = serviceFees[services];\r\n            breakdown.push(`${services.charAt(0).toUpperCase() + services.slice(1)} Specialization: $${serviceFee}`);\r\n\r\n            // Experience discount\r\n            const experienceDiscounts = { new: 0, established: 50, experienced: 100, veteran: 150 };\r\n            const experienceDiscount = experienceDiscounts[experience];\r\n            if (experienceDiscount > 0) breakdown.push(`Experience Discount: -$${experienceDiscount}`);\r\n\r\n            // Professional development (mandatory)\r\n            const professionalDev = 249;\r\n            breakdown.push(`Professional Development Package: $${professionalDev}`);\r\n\r\n            // Calculate total\r\n            const subtotal = totalCost + revenueFee + employeeFee + stateAdjustment + serviceFee + professionalDev - experienceDiscount;\r\n            const gst = subtotal * 0.1;\r\n            const finalTotal = subtotal + gst;\r\n\r\n            breakdown.push(`GST (10%): $${gst.toFixed(2)}`);\r\n            breakdown.push(`<strong style=\"color: #fff; background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; display: block; margin-top: 10px;\">TOTAL ANNUAL COST: $${finalTotal.toFixed(2)} AUD</strong>`);\r\n            breakdown.push(`Monthly Payment Option: $${(finalTotal/12).toFixed(2)}/month`);\r\n\r\n            document.getElementById('costBreakdown').innerHTML = breakdown.join('<br>');\r\n            document.getElementById('resultPanel').style.display = 'block';\r\n        }\r\n\r\n        function calculateScore() {\r\n            const answers = { q1: 'c', q2: 'b', q3: 'b', q4: 'b', q5: 'a' };\r\n            let correct = 0;\r\n            let total = Object.keys(answers).length;\r\n\r\n            for (let question in answers) {\r\n                const selected = document.querySelector(`input[name=\"${question}\"]:checked`);\r\n                if (selected && selected.value === answers[question]) {\r\n                    correct++;\r\n                }\r\n            }\r\n\r\n            const percentage = Math.round((correct / total) * 100);\r\n            const passed = percentage >= 80;\r\n\r\n            document.getElementById('scoreDisplay').innerHTML = `\r\n                <div style=\"font-size: 1.5em; margin-bottom: 10px;\">\r\n                    Score: ${correct}/${total} (${percentage}%)\r\n                </div>\r\n                <div style=\"color: ${passed ? '#4caf50' : '#f44336'}; font-weight: bold; font-size: 1.2em;\">\r\n