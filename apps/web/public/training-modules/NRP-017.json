ive pricing report\r\n            const resultHTML = `\r\n                <div class=\"result-box\">\r\n                    <h3>Complete Pricing Analysis</h3>\r\n\r\n                    <h4 style=\"margin-top: 20px; color: #d4a017;\">Direct Costs Breakdown:</h4>\r\n                    <table style=\"width: 100%; margin-top: 10px;\">\r\n                        <tr><td>Labour (${labourHours}hrs × ${techCount} techs):</td><td style=\"text-align: right;\">$${labourCost.toFixed(2)}</td></tr>\r\n                        <tr><td>Materials & Supplies:</td><td style=\"text-align: right;\">$${materialsCost.toFixed(2)}</td></tr>\r\n                        <tr><td>Equipment Rental (${equipmentDays} days):</td><td style=\"text-align: right;\">$${equipmentCost.toFixed(2)}</td></tr>\r\n                        <tr><td>Subcontractor Costs:</td><td style=\"text-align: right;\">$${subCosts.toFixed(2)}</td></tr>\r\n                        <tr style=\"border-top: 1px solid #ddd; font-weight: bold;\">\r\n                            <td>Total Direct Costs:</td>\r\n                            <td style=\"text-align: right;\">$${directCosts.toFixed(2)}</td>\r\n                        </tr>\r\n                    </table>\r\n\r\n                    <h4 style=\"margin-top: 20px; color: #d4a017;\">Overhead Allocation (35%):</h4>\r\n                    <table style=\"width: 100%; margin-top: 10px;\">\r\n                        <tr><td>Administrative:</td><td style=\"text-align: right;\">$${(overheadCost * 0.25).toFixed(2)}</td></tr>\r\n                        <tr><td>Insurance & Compliance:</td><td style=\"text-align: right;\">$${(overheadCost * 0.30).toFixed(2)}</td></tr>\r\n                        <tr><td>Vehicles & Equipment:</td><td style=\"text-align: right;\">$${(overheadCost * 0.25).toFixed(2)}</td></tr>\r\n                        <tr><td>Facilities & Other:</td><td style=\"text-align: right;\">$${(overheadCost * 0.20).toFixed(2)}</td></tr>\r\n                        <tr style=\"border-top: 1px solid #ddd; font-weight: bold;\">\r\n                            <td>Total Overhead:</td>\r\n                            <td style=\"text-align: right;\">$${overheadCost.toFixed(2)}</td>\r\n                        </tr>\r\n                    </table>\r\n\r\n                    <div style=\"margin-top: 20px; padding: 15px; background: #fff9e6; border-radius: 5px;\">\r\n                        <h4>Pricing Calculation:</h4>\r\n                        <table style=\"width: 100%; margin-top: 10px;\">\r\n                            <tr><td>Total Cost (Direct + Overhead):</td><td style=\"text-align: right;\">$${totalCost.toFixed(2)}</td></tr>\r\n                            <tr><td>Target Margin (${profitMargin}%):</td><td style=\"text-align: right;\">×${markup.toFixed(2)}</td></tr>\r\n                            <tr><td>Base Selling Price:</td><td style=\"text-align: right;\">$${basePrice.toFixed(2)}</td></tr>\r\n                            <tr><td>${customerType} Adjustment:</td><td style=\"text-align: right;\">${((customerAdjustments[customerType]-1)*100).toFixed(0)}%</td></tr>\r\n                            <tr style=\"border-top: 2px solid #ffd700; font-size: 1.2em; color: #d4a017;\">\r\n                                <td><strong>FINAL QUOTE PRICE:</strong></td>\r\n                                <td style=\"text-align: right;\"><strong>$${finalPrice.toFixed(2)}</strong></td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n\r\n                    <div class=\"profit-analysis\">\r\n                        <div class=\"profit-card\">\r\n                            <div class=\"${actualProfit > 0 ? 'profit-value' : 'loss-value'}\">$${actualProfit.toFixed(0)}</div>\r\n                            <div>Net Profit</div>\r\n                        </div>\r\n                        <div class=\"profit-card\">\r\n                            <div class=\"${actualMargin > 15 ? 'profit-value' : 'loss-value'}\">${actualMargin.toFixed(1)}%</div>\r\n                            <div>Actual Margin</div>\r\n                        </div>\r\n                        <div class=\"profit-card\">\r\n                            <div style=\"color: #3498db; font-size: 28px; font-weight: bold;\">$${(finalPrice/area).toFixed(2)}</div>\r\n                            <div>Price per m²</div>\r\n                        </div>\r\n                        <div class=\"profit-card\">\r\n                            <div style=\"color: #9b59b6; font-size: 28px; font-weight: bold;\">$${(finalPrice/(labourHours*techCount)).toFixed(2)}</div>\r\n                            <div>Per Labour Hour</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div style=\"margin-top: 20px; padding: 15px; background: #e8f5e9; border-radius: 5px;\">\r\n                        <h4>Pricing Recommendations:</h4>\r\n                        <ul style=\"margin-left: 20px; margin-top: 10px;\">\r\n                            <li><strong>Break-even Price:</strong> $${breakEven.toFixed(2)}</li>\r\n                            <li><strong>Illustrative Floor Price (10% shown as an example only; margins vary and must be justified per job):</strong> $${minPrice.toFixed(2)}</li>\r\n                            <li><strong>Market Competitive Range:</strong> $${(finalPrice*0.9).toFixed(2)} - $${(finalPrice*1.1).toFixed(2)}</li>\r\n                            <li><strong>Service Level:</strong> ${serviceLevel === 'emergency' ? 'Emergency rates applied (+75%)' : serviceLevel === 'afterhours' ? 'After hours rates (+50%)' : 'Standard rates'}</li>\r\n                            <li><strong>Payment Terms:</strong> ${customerType === 'insurance' ? '45-60 days' : customerType === 'government' ? '30 days' : 'Net 14 days'}</li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n            `;\r\n\r\n            document.getElementById('pricingResult').innerHTML = re